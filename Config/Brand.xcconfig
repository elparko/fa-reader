// Display name and version for the Mac app.
// PRODUCT_NAME is the one place to rename the app (the .app file and the name in menus).
// The direct-download script reads this file. The Xcode target uses it as its base configuration.
// Resources/Info.plist substitutes these build settings.
PRODUCT_NAME = FA Reader
PRODUCT_BUNDLE_IDENTIFIER = com.parkersmith.fa-reader
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
FA_COPYRIGHT = Copyright 2026 Parker Smith
